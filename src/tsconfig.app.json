{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "baseUrl": "./",
    "types": ["node"],
    "paths": {
      "@pipes/*": ["app/pipes/*"],
      "app/*": ["app/*"],
      "@fineract/client": ["../packages/fineract-clients/src"]
    }
  },
  "angularCompilerOptions": {
    "enableIvy": true,
    "fullTemplateTypeCheck": false,
    "preserveWhitespaces": true
  },
  "files": [
    "main.ts",
    "polyfills.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "typings.d.ts",
    "../packages/fineract-clients/src/**/*.ts"
  ]
}
